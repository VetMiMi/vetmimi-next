{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/my",
        "http://localhost:3000/about",
        "http://localhost:3000/my/about",
        "http://localhost:3000/services",
        "http://localhost:3000/services/individual-art-therapy",
        "http://localhost:3000/art-of-wellness",
        "http://localhost:3000/portfolio",
        "http://localhost:3000/stories",
        "http://localhost:3000/stories/stop-trying-make-perfect",
        "http://localhost:3000/contact",
        "http://localhost:3000/book"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!http://localhost:3000/book$)",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/book$",
          "assertions": {
            "categories:accessibility": [
              "warn",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/my/about$",
          "assertions": {
            "resource-summary:font:size": [
              "warn",
              {
                "maxNumericValue": 307200,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    }
  }
}
