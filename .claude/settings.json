{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh project:*)",
      "Bash(gh label:*)",
      "Bash(gh run:*)",
      "Bash(gh api repos/VetMiMi/*)",
      "Bash(gh api graphql:*)",
      "Bash(pnpm install --frozen-lockfile:*)",
      "Bash(pnpm gate:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm i18n:check:*)",
      "Bash(pnpm api:types:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(scripts/gate.sh:*)",
      "Bash(node scripts/check-messages.mjs:*)",
      "Bash(pnpm exec next start -p 3100:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)",
      "Bash(pnpm dev:*)",
      "Bash(next dev:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)"
    ]
  }
}
