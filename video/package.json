{
  "name": "video",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Intro out/intro.mp4 --codec=h264 --crf=23 --muted --concurrency=1 --timeout=120000",
    "poster": "remotion still src/index.ts Intro out/poster.webp --frame=112 --timeout=120000",
    "gif": "remotion ffmpeg -y -loglevel error -i out/intro.mp4 -r 8 -filter_complex \"scale=864:-2:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=diff[p];[b][p]paletteuse=dither=none:diff_mode=rectangle\" out/intro-video.gif",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-myanmar": "5.3.0",
    "@remotion/cli": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
