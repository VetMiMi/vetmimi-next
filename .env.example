# Copy to .env.local for local work. Real values live in .env.local, in
# Vercel and on the live host, never in a committed file. All are server-only:
# no NEXT_PUBLIC_.

# Base URL of the Go API (VetMiMi/vetmimi-api), e.g. http://localhost:8080 locally.
API_URL=
# Shared key the API expects in X-Service-Key on public routes and sign-in (the API's SERVICE_KEY).
API_SERVICE_KEY=
# Shared secret the API sends in X-Revalidate-Secret to POST /api/revalidate when an article publishes (the API's SITE_REVALIDATE_SECRET).
SITE_REVALIDATE_SECRET=
# Public address of the site for canonical links, hreflang, the sitemap and social cards, e.g. https://vetmimi-arts-therapy.vercel.app (optional: Vercel production falls back to its production domain).
SITE_URL=
# "production" on the self-hosted live site only: allows crawling in robots.txt and IndexNow pings (Vercel production counts as live on its own). Set at build time too; see the README.
SITE_ENV=
# IndexNow key (8–128 letters, digits or dashes) served at /indexnow.txt; when set, production pings IndexNow as an article publishes (optional).
INDEXNOW_KEY=
