{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/my",
        "http://localhost:3000/about",
        "http://localhost:3000/my/about",
        "http://localhost:3000/services",
        "http://localhost:3000/services/individual-art-therapy",
        "http://localhost:3000/art-of-wellness",
        "http://localhost:3000/portfolio",
        "http://localhost:3000/stories",
        "http://localhost:3000/contact",
        "http://localhost:3000/book"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/(services|services/individual-art-therapy|stories|contact|book)$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/(|my|about|my/about|art-of-wellness|portfolio)$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/my/about$",
          "aggregationMethod": "median",
          "assertions": {
            "resource-summary:font:size": [
              "warn",
              { "maxNumericValue": 307200 }
            ]
          }
        }
      ]
    }
  }
}
